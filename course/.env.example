# ==============================================================================
# RAG From Scratch - Course Environment Configuration
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env (Linux/macOS) or Copy-Item .env.example .env (PowerShell)
#
# Choose your provider: "openai", "anthropic", "ollama", or "local"
# If left blank, the helper auto-detects based on available keys.
# ==============================================================================

RAG_PROVIDER=local

# ------------------------------------------------------------------------------
# Option 1: OpenAI (Hosted API)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# Option 2: Anthropic (Hosted API - Chat Only)
# Note: Anthropic provides chat models but not embeddings.
# When using Anthropic, embeddings automatically fall back to local sentence-transformers.
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-20241022

# ------------------------------------------------------------------------------
# Option 3: Ollama (Free Local Server)
# Install from https://ollama.com and run:
#   ollama pull llama3.2
#   ollama pull nomic-embed-text
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ------------------------------------------------------------------------------
# Option 4: Local Sentence-Transformers (Free & Offline)
# Default model: sentence-transformers/all-MiniLM-L6-v2 (fast, ~80MB, runs on CPU)
# ------------------------------------------------------------------------------
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# Optional: Cohere Reranking (Notebook 11)
# A local CrossEncoder is used by default; Cohere is optional.
# ------------------------------------------------------------------------------
COHERE_API_KEY=your_cohere_api_key_here
